# Managed by Ansible. Do not edit manually.
storage:
  dbPath: {{ mongodb_data_path }}

systemLog:
  destination: file
  logAppend: true
  path: {{ mongodb_log_path }}

net:
  port: {{ mongodb_port }}
  bindIp: 127.0.0.1,{{ mongo_private_ip }}

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

replication:
  replSetName: {{ replica_set_name }}
